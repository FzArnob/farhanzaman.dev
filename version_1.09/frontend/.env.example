# Optional local development override for the PHP API base URL.
#
# Leave this unset in production: the API host is derived from
# `website_base_url` in data/profile.json (+ "/backend/api"), so the domain is
# configured in exactly one place.
#
# VITE_API_HOST=http://localhost/farhanzaman.dev/version_1.09/backend/api

# When testing from a phone on the same Wi-Fi, use the machine's LAN IP here
# (localhost on the phone means the phone itself):
#
# VITE_API_HOST=http://192.168.0.102/farhanzaman.dev/version_1.09/backend/api
